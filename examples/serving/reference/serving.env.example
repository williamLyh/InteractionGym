# Settings for the reference deployment. Copy to serving.env (next to start.sh) or point IG_SERVING_ENV at a
# copy, and edit. Every value has a default (shown); unset lines keep it. Plain bash: sourced by common.sh.

# --- where things live ---------------------------------------------------------------------------------------
# IG_SERVICES_DIR=<this directory>     # holds envs/, models/, logs/, cache/ unless set separately below
# IG_MODELS_DIR=$IG_SERVICES_DIR/models   # local model directories (names below)
# IG_CACHE_DIR=$IG_SERVICES_DIR/cache     # HF / vLLM / torch.compile / Triton caches
# IG_LOG_DIR=$IG_SERVICES_DIR/logs
# Python environments (directories with bin/vllm):
# IG_LLM_ENV=$IG_SERVICES_DIR/envs/llm    # vLLM, for the user-simulator LLM
# IG_TTS_ENV=$IG_SERVICES_DIR/envs/tts    # vLLM-Omni (stock is fine), for TTS
# IG_OMNI_ENV=$IG_SERVICES_DIR/envs/omni  # vLLM-Omni 0.31.0rc1 + patches/vllm-omni (docs/agent_server.md), for agents
# IG_SESSION_PREFIX=dig_                   # tmux session names: dig_llm, dig_tts0, dig_agent0, ...
# IG_BIND_HOST=127.0.0.1                   # servers listen here only; reach them over an SSH tunnel
# HF_HUB_OFFLINE=1                          # models are local directories

# --- user-simulator LLM (vLLM, OpenAI-compatible) ---------------------------------------------------------------
# LLM_MODEL=Qwen3.8-27B-FP8                 # directory under $IG_MODELS_DIR
# LLM_SERVED="Qwen/Qwen3.8-27B-FP8 Qwen3.8-27B"
# LLM_GPUS=0,1                              # TP x DP GPUs
# LLM_TP=2                                  # tensor-parallel size; DP = #GPUs / TP
# LLM_PORT=8000
# LLM_MAX_NUM_SEQS=128

# --- TTS (vLLM-Omni Qwen3-TTS CustomVoice), replicas behind a least-in-flight proxy -----------------------------
# TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_REPLICAS="6:8002 7:8003"              # gpu:port per replica
# TTS_PORT=8001                             # the proxy clients use

# --- voice-clone TTS (Qwen3-TTS Base), optional ---------------------------------------------------------------
# CLONE_MODEL=Qwen3-TTS-12Hz-1.7B-Base
# CLONE_REPLICAS=""                         # e.g. "6:8030" or "7:8030 6:8031"; empty: not started
# CLONE_PORT=8005

# --- full-duplex agent (MiniCPM-o 4.5 on vLLM-Omni); one server per entry ---------------------------------------
# AGENT_MODEL=MiniCPM-o-4_5
# AGENT_LAYOUT=thinker                      # thinker: one GPU per server, Thinker only, text-only sessions (the
#                                           #   runners' default; needs the patched vLLM-Omni, patches/vllm-omni/)
#                                           # audio: two GPUs per server (Thinker | Talker + Code2Wav), for --audio-out
# AGENT_SERVERS="2:8010 3:8011 4:8012 5:8013"   # gpu(s):port per server; "" for none. thinker default: the four GPUs
#                                           #   the LLM and TTS leave free; audio default: "4,5:8010" (two: "0,1:8010 2,3:8011")
# AGENT_MAX_SESSIONS=16                     # concurrent duplex sessions per server (thinker 16, audio 4); about 8 for
#                                           #   long episodes (Audio MultiChallenge) on thinker: the KV cache is shared
# AGENT_TOKEN_TRACE=1                       # 0 for a stock vLLM-Omni (drops duplex_session.enable_debug_events)
# IG_MINICPMO_OVERLAY=                     # optional overlay root from scripts/make_minicpmo_overlay.py
