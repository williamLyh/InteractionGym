+        return {
+            "session_id": self.session_id,
+            "unit_index": self.unit_index,
+            "end_ms": self.end_ms,
+            "decision": self.decision,
+            "stages": [wire_value(stage) for stage in self.stages],
+            "special_ids": list(self.special_ids),
+        }
