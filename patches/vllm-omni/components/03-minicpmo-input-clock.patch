+        start -= 1
+    unit_ids = ids[start:]
+    speak_id = special_token_ids.get("speak_token_id")
+    if start == 0 and unit_ids[0] != speak_id:
+        return None  # the ids may not reach back to the unit's start (only the last delta): nothing to tell
