+    """Whether the stage bridge hands the Talker nothing for this Stage-0 segment (so no Talker segment end follows).
+
+    The unit's ids are the tail of the Thinker's generated ids after the
+    previous unit terminator (the segment's own ids may be only the last
+    streamed delta), sliced with the bridge's span function on the bridge's
+    inputs (the unit's ids and whether a ``<|tts_bos|>`` was folded into the
+    prompt). Only a segment that ends with a unit terminator is judged;
+    anything else is left to the default (the unit speaks). Returns the
+    label of a unit that ends here (``speak_empty``, or ``listen`` for a unit
+    with no ``<|speak|>``), else ``None``.
+    """
+    if not context.segment_finished:
+        return None
+    completion = _first_completion(output)
+    metadata = _multimodal_output(output, completion)
+    special_token_ids = _special_token_ids(dict(context.segment_output_metadata))
+    special_token_ids.update(_special_token_ids(metadata))
+    listen_id = special_token_ids.get("listen_token_id")
+    terminators = {
+        listen_id,
+        special_token_ids.get("chunk_eos_token_id"),
+        special_token_ids.get("chunk_tts_eos_token_id"),
+    } - {None}
+    ids = max(
