+        clock.end_input(ack)
+    unit = clock.new_unit(input_us=Fraction(3000 * 1_000_000, 48000), epoch=0)
+    clock.settle_unit(unit, "dropped")
+    _append(clock, ms=0, units=0)
+
+    assert (sent[-1].audio_end_ms, sent[-1].unit_end_ms) == (62, 62)
