+# --------------------------------------------------------------------------- #
+# Nemotron VoiceChat: per-frame Stage-0 side channel, Stage-2 audio per frame #
+# --------------------------------------------------------------------------- #
+
+
+async def _open_nemotron(monkeypatch: pytest.MonkeyPatch) -> Harness:
+    monkeypatch.setenv("NEMOTRON_VOICECHAT_LLM_PATH", "test-tokenizer")
+    tokenizer = SimpleNamespace(encode=lambda text, **kwargs: [42], decode=lambda ids, **kwargs: "hi")
+    monkeypatch.setattr(
+        nemotron_plugin_module, "_load_tokenizer_runtime", lambda _: (dict(NEMOTRON_SPECIAL_IDS), tokenizer)
+    )
+    plugin = load_duplex_plugin(NEMOTRON_VOICECHAT_PIPELINE.duplex_plugin, _fake_encode_audio)
+    port = RecordingStagePort(stage_count=3)
+    output: asyncio.Queue = asyncio.Queue()
+    results: asyncio.Queue = asyncio.Queue()
+    limits = DuplexSessionRuntimeConfig()
+    output_buffer = DuplexOutputBuffer(
+        max_bytes=limits.max_pending_output_bytes_per_session,
+        max_events=limits.max_pending_output_events_per_session,
+    )
+    manager = DuplexSessionManager(
+        plugin=plugin,
+        stage_port=port,
+        output_sink=output,
+        result_sink=results,
+        runtime_config=limits,
+        model_config=SimpleNamespace(hf_config=SimpleNamespace(stt_cfg={}), max_model_len=8192),
+    )
+    config = DuplexSessionConfig(
+        model="nemotron",
+        modalities=["audio", "text"],
+        instructions="hi",
+        extra_body={"auto_response": True, **INPUT_CLOCK},
+    )
+    await manager.handle(
+        OpenDuplexSessionMessage(
+            control_id="open", session_id=SESSION_ID, session_config=config, output_buffer=output_buffer
+        )
+    )
+    result = await asyncio.wait_for(results.get(), timeout=2)
+    assert result.ok, result
+    h = Harness(
+        manager=manager,
+        port=port,
+        output=output,
+        output_buffer=output_buffer,
+        results=results,
+        runner=manager.runners[SESSION_ID],
+    )
+    await h.settle()
+    return h
+
+
+def _stage2_audio(request_id: str, frames: int) -> SimpleNamespace:
+    return SimpleNamespace(
+        request_id=request_id,
+        finished=False,
+        outputs=[SimpleNamespace(text="", token_ids=[], multimodal_output={})],
+        multimodal_output={"audio": np.zeros(frames * 1920, dtype=np.float32), "sr": 24000},
+    )
+
+
+async def _nemotron_frame(h: Harness, token_id: int = NEMOTRON_PAD) -> list:
+    await h.run(append_audio(samples=1280))
+    return await h.deliver_and_settle(
+        _stage0_segment_end(h.stage0_request_id(), token_id=token_id),
+        stage_id=0,
+        segment_finished=True,
+        segment_token_ids=[token_id],
+    )
+
+
+async def test_a_nemotron_frame_waits_for_its_stage2_audio_despite_the_stage0_decision(monkeypatch) -> None:
+    h = await _open_nemotron(monkeypatch)
+    try:
+        request_id = h.stage0_request_id()
+        for _ in range(2):
+            events = await _nemotron_frame(h)
+            assert _acks(events) == [], "the Stage-0 token is a side channel"
+
+        events = await h.deliver_and_settle(_stage2_audio(request_id, frames=1), stage_id=2)
+        assert [(a["input_index"], a["units"][0]["decision"]) for a in _acks(events)] == [(1, "listen")]
+        events = await h.deliver_and_settle(_stage2_audio(request_id, frames=1), stage_id=2)
+        assert [a["input_index"] for a in _acks(events)] == [2]
+    finally:
+        await close_harness(h)
+
+
+async def test_a_nemotron_cancel_restarts_the_audio_count_with_the_new_epoch(monkeypatch) -> None:
+    h = await _open_nemotron(monkeypatch)
+    try:
+        old_request_id = h.stage0_request_id(epoch=0)
+        for _ in range(2):
+            await _nemotron_frame(h, token_id=57)
+        events = await h.deliver_and_settle(_stage2_audio(old_request_id, frames=1), stage_id=2)
+        assert [(a["input_index"], a["units"][0]["decision"]) for a in _acks(events)] == [(1, "speak")]
+
+        events = await h.run(commands.CancelResponse())
+        assert h.session.epoch == 1
+        assert [(a["input_index"], a["units"][0]["decision"]) for a in _acks(events)] == [(2, "cancelled")]
+
+        events = await _nemotron_frame(h)
+        assert _acks(events) == [], "the new epoch's first frame waits for the new epoch's audio"
+        new_request_id = h.stage0_request_id(epoch=1)
+        assert new_request_id != old_request_id
+        events = await h.deliver_and_settle(_stage2_audio(new_request_id, frames=1), stage_id=2)
+        assert [(a["input_index"], a["units"][0]["decision"]) for a in _acks(events)] == [(3, "listen")]
+    finally:
+        await close_harness(h)
+
+
+def _nemotron_plugin() -> nemotron_plugin_module.NemotronVoiceChatDuplexPlugin:
+    plugin = nemotron_plugin_module.NemotronVoiceChatDuplexPlugin(_fake_encode_audio)
+    plugin.data_plane.configure_runtime(NEMOTRON_SPECIAL_IDS)
+    return plugin
+
+
+def _nemotron_decision(plugin, token_id: int):
+    decision = DuplexOutputDecision(
+        action=DuplexOutputAction.DIRECT_RESPONSE, metadata={"nvc_text_token_ids": [token_id]}
+    )
+    return plugin.unit_decision(stage_id=0, decision=decision, runtime_config=NEMOTRON_SPECIAL_IDS)
+
+
+def test_nemotron_labels_text_frames_as_speech_and_leaves_talker_segment_ends_alone() -> None:
+    plugin = _nemotron_plugin()
+    assert (_nemotron_decision(plugin, NEMOTRON_PAD).label, _nemotron_decision(plugin, NEMOTRON_PAD).ends_unit) == (
+        "listen",
+        False,
+    )
+    assert (_nemotron_decision(plugin, 57).label, _nemotron_decision(plugin, 1).label) == ("speak", "speak")
+    assert plugin.unit_decision(stage_id=1, decision=None, output=object(), context=None) is None
+
+
+def test_nemotron_frames_are_counted_per_epoch_against_the_ordinal() -> None:
+    plugin = _nemotron_plugin()
+    clock, sent = _clock(plugin)
+
+    def frame_decided(epoch: int) -> None:
+        decision = _nemotron_decision(plugin, NEMOTRON_PAD)
+        _progress(clock, stage_id=0, final_stage_id=2, decision=decision.label, ends_unit=False, epoch=epoch)
+
+    def audio(frames: int, epoch: int) -> None:
+        _progress(
+            clock,
+            stage_id=2,
+            final_stage_id=2,
+            segment_finished=False,
+            output=_stage2_audio("r", frames),
+            epoch=epoch,
+        )
+
+    for _ in range(2):
+        _append(clock, ms=80)
+        frame_decided(0)
+    audio(1, 0)
+    assert [e.input_index for e in sent] == [1]
+
+    clock.cancel_open("client_cancelled", before_epoch=1)  # frame 2's audio is dropped with its epoch
+    (dropped,) = _append(clock, ms=80, epoch=1, accepted=False)
+    clock.append_finished(dropped)
+    for _ in range(2):
+        _append(clock, ms=80, epoch=1)
+        frame_decided(1)
+    assert [e.input_index for e in sent] == [1, 2, 3], "the cancelled frame, then the dropped append"
+
+    audio(1, 1)  # covers the new epoch's first frame (session-wide index 3)
+    assert [e.input_index for e in sent] == [1, 2, 3, 4]
+    audio(1, 1)
+    assert [e.input_index for e in sent] == [1, 2, 3, 4, 5]
+    assert [u["decision"] for e in sent for u in e.units] == ["listen", "cancelled", "dropped", "listen", "listen"]
+
+
+# --------------------------------------------------------------------------- #
+# Commit-based models: a unit is a committed turn                             #
+# --------------------------------------------------------------------------- #
+
+
+def _aura_silent_decision(plugin: AuraDuplexPlugin):
+    output = SimpleNamespace(outputs=[SimpleNamespace(token_ids=[AURA_SILENT_TOKEN_ID], text="")])
+    decision = plugin.decide_output(
+        stage_id=1,
+        final_stage_id=3,
+        segment_finished=True,
+        segment_token_ids=(AURA_SILENT_TOKEN_ID,),
+        segment_output_metadata={},
+        output=output,
+    )
+    assert decision is not None
+    return plugin.unit_decision(stage_id=1, decision=decision)
+
+
+def _aura_audio(*, finished: bool) -> SimpleNamespace:
+    return SimpleNamespace(finished=finished, outputs=[], multimodal_output={})
+
+
+def test_an_aura_turn_ends_with_its_final_request_not_with_a_sentence_segment() -> None:
+    clock, sent = _clock(AuraDuplexPlugin(_fake_encode_audio))
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=3)  # ASR transcript: the turn speaks
+    _progress(clock, stage_id=1, final_stage_id=3)  # AURA's text, no silent decision
+    for _ in range(2):  # two sentences: a Talker and a Code2Wav segment end each
+        _progress(clock, stage_id=2, final_stage_id=3)
+        _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=False))
+    assert sent == []
+
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=True))
+    assert sent[0].units == ({"end_ms": 1000, "decision": "speak"},)
+
+
+def test_a_silent_aura_turn_ends_on_its_stage1_decision() -> None:
+    plugin = AuraDuplexPlugin(_fake_encode_audio)
+    decision = _aura_silent_decision(plugin)
+    assert (decision.label, decision.ends_unit) == ("listen", True)
+    clock, sent = _clock(plugin)
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=3)
+    _progress(clock, stage_id=1, final_stage_id=3, decision=decision.label)
+    assert sent[0].units == ({"end_ms": 1000, "decision": "listen"},)
