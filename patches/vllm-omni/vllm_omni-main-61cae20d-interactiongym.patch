+async def test_a_personaplex_frame_is_acknowledged_once_code2wav_emitted_what_it_can() -> None:
+    h = await open_personaplex_harness(extra_body=INPUT_CLOCK)
+    try:
+        request_id = h.stage0_request_id()
+        acked: list[int] = []
+        for n in range(1, 8):
+            await h.run(frame())
+            events = await h.deliver_and_settle(_stage0_segment_end(request_id), stage_id=0, segment_finished=True)
+            acked += [ack["input_index"] for ack in _acks(events)]
+            if n in (2, 7):
+                assert acked[-1:] != [n], f"frame {n} must wait for its Code2Wav chunk"
+                frames = 1 if n == 2 else 6
+                events = await h.deliver_and_settle(
+                    code2wav_output(request_id, samples=frames * FRAME_SIZE, text=""), stage_id=1
+                )
+                acked += [ack["input_index"] for ack in _acks(events)]
+            assert acked[-1] == n, f"frame {n} not acknowledged"
+        assert acked == list(range(1, 8))
+    finally:
+        await close_harness(h)
+
