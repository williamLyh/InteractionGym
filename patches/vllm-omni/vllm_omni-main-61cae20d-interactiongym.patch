+
+@pytest.mark.parametrize("tokenizer", [_UnnamingTokenizer, _BrokenVocabTokenizer])
+def test_a_tokenizer_failure_neither_withholds_the_acknowledgement_nor_breaks_the_teardown(tokenizer) -> None:
