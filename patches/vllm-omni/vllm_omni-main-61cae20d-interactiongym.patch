+# --------------------------------------------------------------------------- #
+# PersonaPlex: always speaking, Code2Wav emits chunks of frames                #
+# --------------------------------------------------------------------------- #
+
+
+def test_personaplex_flushed_frames_follow_the_bridge_chunking() -> None:
+    plugin = PersonaPlexDuplexPlugin(_fake_encode_audio)
+    assert [plugin.flushed_audio_frames(n) for n in range(1, 13)] == [0, 1, 1, 1, 1, 1, 6, 6, 6, 6, 6, 11]
+    plugin.input_clock_initial_codec_chunk_frames = 0
+    assert [plugin.flushed_audio_frames(n) for n in range(1, 8)] == [0, 0, 0, 0, 0, 5, 5]
+
