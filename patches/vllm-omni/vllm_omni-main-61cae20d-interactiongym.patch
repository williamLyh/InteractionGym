+def test_an_aura_turn_after_a_cancel_completes_on_its_own_request() -> None:
+    clock, sent = _clock(AuraDuplexPlugin(_fake_encode_audio))
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=3)
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=False))
+    clock.cancel_open("barge_in", before_epoch=1)
+    assert _decisions(sent) == [[("cancelled", "barge_in")]]
+
+    _commit(clock, epoch=1)
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=True), epoch=0)  # late, dropped
+    _progress(clock, stage_id=0, final_stage_id=3, epoch=1)
+    assert len(sent) == 1
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=True), epoch=1)
+    assert [e.input_index for e in sent] == [1, 2] and sent[1].units == ({"end_ms": 2000, "decision": "speak"},)
+
+
+def test_a_silent_aura_turn_committed_during_a_drain_waits_for_the_turn_still_speaking() -> None:
+    """An input-clocked session never overlaps AURA's turns (PR1 keeps the concurrent-turn gate closed).
+
+    The next turn's commit is deferred until the turn whose TTS drains has finished, so its silent Stage-1
+    decision can no longer complete that turn (``test_an_input_clocked_session_never_overlaps_turns`` covers the
+    gate in the runner).
+    """
+    plugin = AuraDuplexPlugin(_fake_encode_audio)
+    clock, sent = _clock(plugin)
+    first = _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=3)
+    _progress(clock, stage_id=1, final_stage_id=3)  # Stage 1 done: TTS drains; a commit now is deferred
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=False))
+    assert not first.complete and sent == []
+    _progress(clock, stage_id=3, final_stage_id=3, output=_aura_audio(finished=True))
+    assert first.complete
+    second = _commit(clock)  # the deferred turn, submitted once the response ended
+    _progress(clock, stage_id=0, final_stage_id=3)
+    _progress(clock, stage_id=1, final_stage_id=3, decision=_aura_silent_decision(plugin).label)
+
+    assert second.complete
+    assert [unit["decision"] for event in sent for unit in event.units] == ["speak", "listen"]
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="PR1 gap: the unit's audio length comes from the reservation's admission byte count, which an AURA "
+    "commit reservation inflates with its retained video frames",
+)
+def test_an_aura_turns_unit_end_counts_its_audio_not_its_video_frames() -> None:
+    buffer = AuraPcmAppendBuffer()
+    audio = base64.b64encode(bytes(4 * 16000)).decode()  # 1 s at 16 kHz
+    buffer.prepare_append(
+        {"audio": audio, "format": "pcm_f32le", "sample_rate_hz": 16000, "video_frames": ["A" * 40000]},
+        operation_id="a",
+        chunk_period_ms=1000,
+        allow_emit=True,
+    )
+    reservation = buffer.prepare_commit(operation_id="c", chunk_period_ms=1000)
+    fake_runner = SimpleNamespace(model_state=SimpleNamespace(committed_audio_reserved_bytes=0))
+    input_us = DuplexSessionRunner._unit_input_us(fake_runner, reservation.payload, reservation, None)
+    assert input_us == Fraction(1_000_000)
+
+
+def test_a_qwen3_omni_turn_uses_the_default_final_stage_segment_end_and_survives_a_cancel() -> None:
+    clock, sent = _clock(Qwen3OmniDuplexPlugin(_fake_encode_audio))
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=2)  # Thinker finished
+    _progress(clock, stage_id=1, final_stage_id=2)  # Talker finished
+    _progress(clock, stage_id=2, final_stage_id=2, segment_finished=False, output=object())
+    assert sent == []
+    _progress(clock, stage_id=2, final_stage_id=2, output=object())
+    assert sent[0].units == ({"end_ms": 1000, "decision": "speak"},)
+
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=2)
+    clock.cancel_open("client_cancelled", before_epoch=1)
+    _commit(clock, epoch=1)
+    _progress(clock, stage_id=2, final_stage_id=2, output=object(), epoch=0)  # late output of the cancelled turn
+    _progress(clock, stage_id=0, final_stage_id=2, epoch=1)
+    _progress(clock, stage_id=1, final_stage_id=2, epoch=1)
+    assert len(sent) == 2
+    _progress(clock, stage_id=2, final_stage_id=2, output=object(), epoch=1)
+    assert _decisions(sent) == [[("speak", None)], [("cancelled", "client_cancelled")], [("speak", None)]]
+
+
+def test_a_text_only_turn_completes_at_its_final_stage_segment_end() -> None:
+    """A Qwen3-Omni turn without audio output ends on the Thinker (final stage 0)."""
+    clock, sent = _clock(Qwen3OmniDuplexPlugin(_fake_encode_audio))
+    _commit(clock)
+    _progress(clock, stage_id=0, final_stage_id=0)
+    assert sent[0].units == ({"end_ms": 1000, "decision": "speak"},)
+
+
+def test_only_models_without_an_open_prerequisite_opt_into_the_input_clock() -> None:
+    """Qwen3-Omni opts in; the others' hooks are ready but wait for an engine prerequisite (see their plugins)."""
+    assert _DECLARED_OPT_IN == {
+        nemotron_plugin_module.NemotronVoiceChatDuplexPlugin: False,
+        PersonaPlexDuplexPlugin: False,
+        AuraDuplexPlugin: False,
+        Qwen3OmniDuplexPlugin: True,
+    }
