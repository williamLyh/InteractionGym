+@pytest.fixture(autouse=True)
+def _models_stand_in_as_opted_in(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Let the not-yet-opted-in models run input-clocked sessions here, as PR1's runner tests do for MiniCPM-o."""
+    for plugin_class in _NOT_YET_OPTED_IN:
