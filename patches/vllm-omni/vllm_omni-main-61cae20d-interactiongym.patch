+def test_the_personaplex_buffer_hands_out_every_whole_frame_an_append_completed() -> None:
+    buffer = PersonaPlexPcmAppendBuffer()
+    payload = {
+        "type": "audio",
+        "audio": base64.b64encode(bytes(4 * (3 * FRAME_SIZE + 100))).decode(),
+        "format": "pcm_f32le",
+        "sample_rate_hz": 24000,
+    }
+    first = buffer.prepare_append(payload, operation_id="a", chunk_period_ms=80, allow_emit=True)
+    assert first is not None and first.byte_count == 4 * FRAME_SIZE
+    backlog = [buffer.prepare_backlog(operation_id=f"b{i}", chunk_period_ms=80) for i in range(3)]
+    assert [r.byte_count if r is not None else None for r in backlog] == [4 * FRAME_SIZE, 4 * FRAME_SIZE, None]
+    assert buffer.pending_byte_count == 4 * 100
+    backlog[1].rollback()  # a failed submission gives its frame (and those after it) back, in order
+    assert buffer.pending_byte_count == 4 * (FRAME_SIZE + 100)
+
