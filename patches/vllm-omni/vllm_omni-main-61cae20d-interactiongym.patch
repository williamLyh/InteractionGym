+    clock.note_input_audio(ack, samples=16000, sample_rate_hz=16000)
+    clock.refuse_input(ack, "input_backpressure")
+    clock.end_input(ack)
+    _append(clock, ms=200, units=0)
+
+    assert [(e.input_index, e.audio_end_ms, e.decision) for e in sent] == [
+        (1, 200, None),
+        (2, 200, "rejected"),
+        (3, 400, None),
+    ]
