+async def test_a_personaplex_cancel_restarts_the_frame_count_with_the_new_epoch() -> None:
+    h = await open_personaplex_harness(extra_body=INPUT_CLOCK)
+    try:
+        old_request_id = h.stage0_request_id(epoch=0)
+        for _ in range(2):
+            await h.run(frame())
+            await h.deliver_and_settle(_stage0_segment_end(old_request_id), stage_id=0, segment_finished=True)
+        await h.deliver_and_settle(code2wav_output(old_request_id, samples=FRAME_SIZE, text="he"), stage_id=1)
+        assert [a["input_index"] for a in _acks(h.events)] == [1, 2]
+
+        await h.run(commands.CancelResponse())
+        assert h.session.epoch == 1
+
+        new_request_id = h.stage0_request_id(epoch=1)
+        acked: list[int] = []
+        for _ in range(2):
+            await h.run(frame())
+            events = await h.deliver_and_settle(_stage0_segment_end(new_request_id), stage_id=0, segment_finished=True)
+            acked += [a["input_index"] for a in _acks(events)]
+        assert acked == [3], "the epoch's first frame needs no audio; its second waits for the epoch's first chunk"
+        events = await h.deliver_and_settle(code2wav_output(new_request_id, samples=FRAME_SIZE, text=""), stage_id=1)
+        assert [a["input_index"] for a in _acks(events)] == [4]
+    finally:
+        await close_harness(h)
+
