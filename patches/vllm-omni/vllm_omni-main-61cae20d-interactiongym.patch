+def test_personaplex_frames_are_counted_per_epoch_against_the_ordinal() -> None:
+    """After a cancel the Code2Wav count starts over with the new Stage-0 request."""
+    clock, sent = _clock(PersonaPlexDuplexPlugin(_fake_encode_audio))
+    for _ in range(7):  # epoch 0: frames 1..7 speak; Code2Wav emitted the first chunk (1 frame)
+        _append(clock, ms=80)
+        _progress(clock, stage_id=0, final_stage_id=1)
+    _progress(clock, stage_id=1, final_stage_id=1, segment_finished=False, output=_code2wav(frames=1))
+    assert [e.input_index for e in sent] == [1, 2, 3, 4, 5, 6], "frame 7 waits for the next chunk"
+
+    clock.cancel_open("client_cancelled", before_epoch=1)
+    assert _decisions(sent)[-1] == [("cancelled", "client_cancelled")]
+    (dropped,) = _append(clock, ms=80, epoch=1, accepted=False)
+    clock.append_finished(dropped)  # never reached Stage 0: takes no ordinal
+    for _ in range(2):
+        _append(clock, ms=80, epoch=1)
+        _progress(clock, stage_id=0, final_stage_id=1, epoch=1)
+
+    # The new epoch's first frame needs no audio (flushed(1) == 0); its second needs the
+    # new epoch's first chunk. (Epoch 0's count of 1 would complete it at once.)
+    assert [e.input_index for e in sent] == [1, 2, 3, 4, 5, 6, 7, 8, 9]
+    _progress(clock, stage_id=1, final_stage_id=1, segment_finished=False, output=_code2wav(frames=1), epoch=1)
+    assert [e.input_index for e in sent] == list(range(1, 11))
+    assert [u["decision"] for e in sent[6:] for u in e.units] == ["cancelled", "dropped", "speak", "speak"]
+
