+def _code2wav(*, frames: int) -> SimpleNamespace:
+    """Cumulative Code2Wav audio of ``frames`` frames (as the clock hands it to the hook)."""
+    return SimpleNamespace(
+        finished=False,
+        outputs=[SimpleNamespace(text="", token_ids=[], multimodal_output={})],
+        multimodal_output={"audio": np.zeros(frames * FRAME_SIZE, dtype=np.float32), "sr": 24000},
+    )
+
