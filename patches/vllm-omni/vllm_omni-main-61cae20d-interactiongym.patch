+
+def _acks(events: list) -> list[dict[str, Any]]:
+    return [event.to_realtime() for event in events if event.type == "input_audio_buffer.processed"]
+
+
+def _stage0_segment_end(request_id: str, token_id: int = 7) -> SimpleNamespace:
+    return SimpleNamespace(
+        request_id=request_id,
+        finished=False,
+        multimodal_output={},
+        outputs=[SimpleNamespace(text="", token_ids=[token_id], multimodal_output={})],
+    )
+
+
+def _commit(clock: InputClock, *, epoch: int = 0, ms: int = 1000) -> InputClockUnit:
+    """One committed turn: a commit that submits one Stage-0 request, accepted by Stage 0."""
+    ack = _begin(clock, COMMIT)
+    unit = clock.new_unit(input_us=ms * 1000, epoch=epoch, turn=f"turn-{clock.input_count}")
+    clock.unit_submitted(unit)
+    clock.end_input(ack)
+    return unit
+
