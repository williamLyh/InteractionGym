+    assert unit["decision"] == "speak"
+    assert [s["stage"] for s in unit["stages"]] == ["stage0", "stage1"]
+    assert unit["stages"][1]["output"] == [[41, "code:41"], [42, "code:42"]]
+    assert isinstance(sent[2], InputProcessed)
