+async def test_a_personaplex_append_of_several_frames_is_acknowledged_once_after_all_of_them() -> None:
+    h = await open_personaplex_harness(extra_body=INPUT_CLOCK)
+    try:
+        request_id = h.stage0_request_id()
+        await h.run(frame(samples=3 * FRAME_SIZE))
+        assert len(h.port.submissions) == 3, "every whole frame of the append is submitted"
+        events: list = []
+        for _ in range(3):
+            events += await h.deliver_and_settle(_stage0_segment_end(request_id), stage_id=0, segment_finished=True)
+        assert _acks(events) == [], "frames 2 and 3 wait for the first Code2Wav chunk"
+        events = await h.deliver_and_settle(code2wav_output(request_id, samples=FRAME_SIZE, text=""), stage_id=1)
+        (ack,) = _acks(events)
+        assert ack["input_index"] == 1 and [u["decision"] for u in ack["units"]] == ["speak"] * 3
+        assert ack["unit_end_ms"] == 240
+    finally:
+        await close_harness(h)
